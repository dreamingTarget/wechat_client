}

#ApplyFriend #widget_label_list #tipslb {
    font-size: 12px;
    font-family: "Microsoft YaHei";
}

#ApplyFriend #widget_apply #tipslb[state='normal'],
#ApplyFriend #widget_label_list #tipslb[state='normal'] {
    padding: 2px 10px;
    background: #ededed;
    color: #5a5a5a;
    border-radius: 10px;
}

#ApplyFriend #widget_apply #tipslb[state='hover'],
#ApplyFriend #widget_label_list #tipslb[state='hover'] {
    padding: 2px 10px;
    background: #e6e6e6;
    color: #383838;
    border-radius: 10px;
}

#ApplyFriend #widget_apply #tipslb[state='pressed'],
#ApplyFriend #widget_label_list #tipslb[state='pressed'] {
    padding: 2px 10px;
    background: #dff3e6;
    color: #07c160;
    border-radius: 10px;
}

#ApplyFriend #widget_apply #tipslb[state='selected_normal'],
#ApplyFriend #widget_label_list #tipslb[state='selected_normal'] {
    padding: 2px 10px;
    background: #dff3e6;
    color: #07c160;
    border: none;
    border-radius: 10px;
}

#ApplyFriend #widget_apply #tipslb[state='selected_hover'],
#ApplyFriend #widget_label_list #tipslb[state='selected_hover'] {
    padding: 2px 10px;
    background: #d7efdf;
    color: #06ae57;
    border: none;
    border-radius: 10px;
}

#ApplyFriend #widget_apply #tipslb[state='selected_pressed'],
#ApplyFriend #widget_label_list #tipslb[state='selected_pressed'] {
    padding: 2px 10px;
    background: #cfead8;
    color: #05954c;
    border: none;
    border-radius: 10px;
}

